    {
      "id": "research",
      "type": "flow",
      "title": "Proposed design: from bounded search to a separate release decision",
      "desc": "Proposed design, not a deployed integration. IRB refinement offers a reuse facade to an external, trusted DGM controller with its archive. The controller sends a RunSpec to a bounded, Karpathy-style experiment loop and receives development evidence back. Optional JEV advice can rank or abstain but has no execution authority. Artifacts go to an independent evaluation. Only after search stops does a promotion gate run a separate held-out suite and a final audit, and human approval leads to a separate release decision. No promotion or final-audit feedback returns to the same search campaign.",
      "lanes": [
        {"id": "search", "label": "Search control and bounded trials"},
        {"id": "promotion", "label": "Post-search promotion"}
      ],
      "nodes": [
        {"id": "irb", "label": "IRB refinement", "sublabel": "Selective reuse only", "state": "planned", "lane": "search"},
        {"id": "dgm", "label": "DGM controller", "sublabel": "External, trusted, with archive", "state": "planned", "lane": "search"},
        {"id": "loop", "label": "Bounded experiment loop", "sublabel": "Karpathy-style, local", "state": "planned", "lane": "search"},
        {"id": "eval", "label": "Independent evaluation", "sublabel": "Frozen development protocol", "state": "planned", "lane": "search"},
        {"id": "jev", "label": "JEV advice", "sublabel": "Optional, advisory only", "state": "optional", "lane": "search"},
        {"id": "promotion", "label": "Promotion gate", "sublabel": "Held-out suite, final audit", "state": "planned", "lane": "promotion"},
        {"id": "release", "label": "Release decision", "sublabel": "Separate release action", "state": "planned", "lane": "promotion"}
      ],
      "edges": [
        {"from": "irb", "to": "dgm", "label": "reuse facade", "kind": "request"},
        {"from": "dgm", "to": "loop", "label": "RunSpec", "kind": "request"},
        {"from": "loop", "to": "dgm", "label": "dev evidence", "kind": "result"},
        {"from": "loop", "to": "eval", "label": "artifact", "kind": "request"},
        {"from": "jev", "to": "dgm", "label": "ranking / abstain", "kind": "optional"},
        {"from": "eval", "to": "promotion", "label": "after search stops", "kind": "request"},
        {"from": "promotion", "to": "release", "label": "human approval", "kind": "request"}
      ],
      "layouts": {
        "wide": {
          "grid": 8,
          "size": [130, 36],
          "prefer": "horizontal",
          "nodes": {
            "irb": [3, 3, 21, 11],
            "dgm": [37, 3, 21, 11],
            "loop": [71, 3, 21, 11],
            "eval": [105, 3, 21, 11],
            "jev": [37, 22, 21, 11],
            "release": [71, 22, 21, 11],
            "promotion": [105, 22, 21, 11]
          },
          "routes": {
            "eval>promotion": {
              "label": "left"
            }
          }
        },
        "narrow": {
