{
  "version": 1,
  "about": "Source for the landing-page diagrams. Run `npm run diagrams` to rewrite the inline SVG in public/index.html; `node scripts/diagrams.mjs --check` fails when the page is out of date. Coordinates are in grid units (layout.grid px each). Wording comes from the page, the repository README and the published figure text.",
  "diagrams": [
    {
      "id": "how",
      "type": "flow",
      "title": "How it would work: four owner-controlled steps",
      "desc": "The owner sits at the centre and decides each step in order: choose your capacity, choose who can use it, set limits and keep visibility, then revoke access when needed. The first two steps are proposed, the third is planned controls, and revocation is not live. Secure sharing is not live yet.",
      "lanes": [
        {"id": "owner", "label": "Owner"},
        {"id": "steps", "label": "Steps"}
      ],
      "nodes": [
        {"id": "owner", "label": "Owner", "sublabel": "Your compute, your terms", "state": "none", "lane": "owner"},
        {"id": "capacity", "label": "Choose your capacity", "sublabel": "Local CPUs, GPUs, clusters", "state": "planned", "stateLabel": "Proposed", "lane": "steps"},
        {"id": "people", "label": "Choose who can use it", "sublabel": "People and teams", "state": "planned", "stateLabel": "Proposed", "lane": "steps"},
        {"id": "limits", "label": "Set limits and keep visibility", "sublabel": "Usage and access", "state": "planned", "stateLabel": "Planned controls", "lane": "steps"},
        {"id": "revoke", "label": "Revoke access when needed", "sublabel": "Owner control", "state": "notlive", "stateLabel": "Not live", "lane": "steps"}
      ],
      "edges": [
        {"from": "owner", "to": "capacity", "kind": "architectural"},
        {"from": "owner", "to": "people", "kind": "architectural"},
        {"from": "owner", "to": "limits", "kind": "architectural"},
        {"from": "owner", "to": "revoke", "kind": "architectural"},
        {"from": "capacity", "to": "people", "kind": "request"},
        {"from": "people", "to": "limits", "kind": "request"},
        {"from": "limits", "to": "revoke", "kind": "request"}
      ],
